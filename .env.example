# API Keys
APIFY_API_TOKEN=your_apify_free_tier_token
SERPER_API_KEY=your_serper_key
BRAVE_API_KEY=your_brave_key_optional
GOOGLE_API_KEY=your_google_api_key_optional

# Local LLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# Paths
RAW_DATA_PATH=./data/raw
PROCESSED_PATH=./data/processed
OUTPUT_PATH=./data/output
QUARANTINE_PATH=./data/quarantine

# Govt Data Paths
CBI_RCMC_PDF_PATH=./data/raw/govt/cbi_rcmc_2024.pdf
APEDA_LIST_PATH=./data/raw/govt/apeda_exporters.html

# Database
DATABASE_URL=sqlite:///./data/indian_coffee_intel.db

# Pipeline Config
MAX_MAPS_RESULTS=150
FUZZY_MATCH_THRESHOLD=88
GEO_DEDUP_DISTANCE_METERS=75.0
MAX_CONCURRENT_APIFY_RUNS=2
MAX_CONCURRENT_OLLAMA=3
SERPER_MONTHLY_LIMIT=2500
BRAVE_MONTHLY_LIMIT=2000
NOMINATIM_RATE_LIMIT_SECONDS=1.0